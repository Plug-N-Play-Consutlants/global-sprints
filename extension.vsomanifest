{
  "manifestVersion": 1,
  "scopes": [
    "vso.work",
    "vso.work_write",
    "vso.extension.data",
    "vso.extension.data_write",
    "vso.graph"
  ],
  "contributions": [
    {
      "id": "global-sprints-hub",
      "type": "ms.vss-web.hub",
