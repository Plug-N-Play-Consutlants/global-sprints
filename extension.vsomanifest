      }
    },
    {
      "id": "global-sprints-organization-hub",
      "type": "ms.vss-web.hub",
      "targets": [
        "ms.vss-web.collection-admin-hub-group"
      ],
      "properties": {
        "name": "Global Sprints",
        "uri": "index.html",
        "icon": "images/icon.png",
        "order": 80
      }
    }
  ],
  "contributionTypes": [],
  "version": "1.0.29"
}